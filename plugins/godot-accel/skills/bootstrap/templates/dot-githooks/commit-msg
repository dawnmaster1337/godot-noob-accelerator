#!/usr/bin/env bash
# identity-guard: commit-msg -- keeps the real-identity strings out of messages.
set -u
. "$(dirname "$0")/lib.sh"
PATTERNS="${IDENTITY_GUARD_PATTERNS:-$IG_DIR/patterns}"
msg_file="${1:-}"
if ig_active && [ -n "$msg_file" ] && [ -r "$msg_file" ] && ! ig_allow_has "!messages" \
   && pf=$(ig_clean_patterns "$PATTERNS"); then
  trap 'rm -f "$pf"' EXIT
  if grep -qIiEf "$pf" "$msg_file"; then
    printf '\n[identity-guard] COMMIT BLOCKED: the commit message contains protected identity strings.\n\n' >&2
    exit 1
  fi
fi
proj="$(dirname "$0")/commit-msg.project"
[ -x "$proj" ] && exec "$proj" "$@"
exit 0
